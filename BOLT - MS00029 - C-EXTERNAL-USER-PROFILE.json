        "subject": "=Credencial Criada para BOLT 2.0 ({{ $json.name }})",
        "html": "=<!DOCTYPE html>\n\n<html lang=\"pt-BR\">\n\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Criação de CREDENCIAL para BOLT 2.0</title>\n</head>\n\n<body style=\"margin:0;padding:0;background-color:#f4f6f9;font-family:Arial,Helvetica,sans-serif;\">\n\n    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#f4f6f9;padding:30px 0;\">\n        <tr>\n            <td align=\"center\">\n\n                <table width=\"650\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"\n                    style=\"background:#ffffff;border-radius:8px;overflow:hidden;border:1px solid #e5e7eb;\">\n\n                    <!-- Cabeçalho -->\n                    <tr>\n                        <td align=\"center\" style=\"background-color:#0f172a;padding:30px;\">\n                            <img src=\"https://raw.githubusercontent.com/projetoolimpodev-ai/images/main/logo.png\"\n                                alt=\"BOLT\" width=\"220\" style=\"display:block;border:0;max-width:220px;\">\n                        </td>\n                    </tr>\n\n                    <!-- Título -->\n                    <tr>\n                        <td style=\"padding:30px 40px 10px 40px;\">\n                            <h2 style=\"margin:0;color:#111827;\">\n                                Criação de CREDENCIAL para BOLT 2.0\n                            </h2>\n                        </td>\n                    </tr>\n\n                    <!-- Conteúdo -->\n                    <tr>\n                        <td style=\"padding:10px 40px 40px 40px;color:#374151;font-size:14px;line-height:1.7;\">\n\n                            <p>\n                                Olá,\n                                <strong>{{ $json.name }}</strong>,\n                            </p>\n\n                            <p>\n                                Sua credencial para Acessar o <b>BOLT 2.0</b> foi criada com sucesso:\n                            </p>\n\n                            <table width=\"100%\" cellpadding=\"10\" cellspacing=\"0\" border=\"0\"\n                                style=\"border-collapse:collapse;border:1px solid #d1d5db;margin-top:20px;margin-bottom:20px;\">\n\n                                <tr>\n                                    <td width=\"160\" style=\"background:#f9fafb;border-bottom:1px solid #d1d5db;\">\n                                        <strong>E-Mail de Acesso</strong>\n                                    </td>\n                                    <td style=\"border-bottom:1px solid #d1d5db;\">\n                                        {{ $json.email }}\n                                    </td>\n                                </tr>\n\n                                <tr>\n                                    <td style=\"background:#f9fafb;border-bottom:1px solid #d1d5db;\">\n                                        <strong>Senha Temporária</strong>\n                                    </td>\n                                    <td style=\"border-bottom:1px solid #d1d5db;\">\n                                        {{ $json.password }}\n                                    </td>\n                                </tr>\n\n                                <tr>\n                                    <td style=\"background:#f9fafb;\">\n                                        <strong>Scopes</strong>\n                                    </td>\n                                    <td>\n                                        <ul style=\"margin:0;padding-left:20px;\">\n                                            {{\n                                            $json.scopes\n                                            .map(scope => `<li><strong>${scope}</strong></li>\n                                            `)\n                                            .join('')\n                                            }}\n                                        </ul>\n                                    </td>\n                                </tr>\n\n                            </table>\n\n                            <p>\n                                A senha deve ser alterada no primeiro acesso.\n                            </p>\n\n                            <p>\n                                Em caso de dúvida entre em contato com o solicitante da sua empresa.\n                            </p>\n\n                            <br>\n\n                            <p style=\"margin-bottom:0;\">\n                                At.te.,\n                            </p>\n\n                            <p style=\"margin-top:5px;\">\n                                <strong>Equipe BOLT de Segurança</strong>\n                            </p>\n\n                        </td>\n                    </tr>\n\n                    <!-- Rodapé -->\n                    <tr>\n                        <td align=\"center\"\n                            style=\"background:#f9fafb;padding:20px;font-size:12px;color:#6b7280;border-top:1px solid #e5e7eb;\">\n\n                            Esta é uma mensagem automática enviada pelo Sistema BOLT.<br>\n                            Não responda este e-mail.\n\n                        </td>\n                    </tr>\n\n                </table>\n\n            </td>\n        </tr>\n\n    </table>\n\n</body>\n\n</html>",
