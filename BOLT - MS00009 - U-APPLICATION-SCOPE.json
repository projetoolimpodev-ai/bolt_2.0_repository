        "mode": "runOnceForEachItem",
        "jsCode": "const data = $('Webhook').item.json.body;\nconst updateAux = [];\n\nif (data.name) {\n  updateAux.push(\"name\");\n}\nif (data.mnemonic) {\n  updateAux.push(\"mnemonic\");\n}\nif (data.description) {\n  updateAux.push(\"description\");\n}\nif (data.status) {\n  updateAux.push(\"status\");\n}\nif (data.scopes) {\n  updateAux.push(\"scopes\");\n}\nif (data.requester) {\n  updateAux.push(\"requester\");\n}\n\ndata.updatedAt = new Date;\nupdateAux.push(\"updatedAt\");\n\ndata.update = updateAux.join(\", \");\n\nreturn data;"
      },
