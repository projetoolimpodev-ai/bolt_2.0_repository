    {
      "parameters": {
        "jsCode": "function gerarSenha(tamanho = 8) {\n  \n  if (tamanho < 8) {\n    throw new Error(\"A senha deve ter pelo menos 8 caracteres.\");\n  }\n\n  const maiusculas = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\";\n  const minusculas = \"abcdefghijklmnopqrstuvwxyz\";\n  const numeros = \"0123456789\";\n  const especiais = \"@#$%&*!?\";\n\n  const todos = maiusculas + minusculas + numeros + especiais;\n\n  const randomChar = (chars) =>\n    chars[Math.floor(Math.random() * chars.length)];\n\n  const senha = [\n    randomChar(maiusculas),\n    randomChar(minusculas),\n    randomChar(numeros),\n    randomChar(especiais),\n  ];\n\n  while (senha.length < tamanho) {\n    senha.push(randomChar(todos));\n  }\n\n  for (let i = senha.length - 1; i > 0; i--) {\n    const j = Math.floor(Math.random() * (i + 1));\n    [senha[i], senha[j]] = [senha[j], senha[i]];\n  }\n\n  return senha.join(\"\");\n}\n\n\nlet password = gerarSenha();\nlet email = $input.first().json.email;\nlet _id = $input.first().json._id;\n\nreturn { body: { email, password, _id  } }"
      },
