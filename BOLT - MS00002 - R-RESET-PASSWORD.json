      "parameters": {
        "fromEmail": "EQUIPE BOLT SECURiTY <projeto.olimpo.dev@gmail.com>",
        "toEmail": "={{ $('Generate Check Code').item.json.email }}",
        "subject": "=Solicitação de Reset de Senha ({{ $('Generate Check Code').item.json.email }})",
        "html": "=<!DOCTYPE html>\n\n<html lang=\"pt-BR\">\n\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Reset de Senha</title>\n</head>\n\n<body style=\"margin:0;padding:0;background-color:#f4f6f9;font-family:Arial,Helvetica,sans-serif;\">\n\n    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#f4f6f9;padding:30px 0;\">\n        <tr>\n            <td align=\"center\">\n\n                <table width=\"650\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"\n                    style=\"background:#ffffff;border-radius:8px;overflow:hidden;border:1px solid #e5e7eb;\">\n\n                    <!-- Cabeçalho -->\n                    <tr>\n                        <td align=\"center\" style=\"background-color:#0f172a;padding:30px;\">\n                            <img src=\"https://raw.githubusercontent.com/projetoolimpodev-ai/images/main/logo.png\"\n                                alt=\"BOLT\" width=\"220\" style=\"display:block;border:0;max-width:220px;\">\n                        </td>\n                    </tr>\n\n                    <!-- Título -->\n                    <tr>\n                        <td style=\"padding:30px 40px 10px 40px;\">\n                            <h2 style=\"margin:0;color:#111827;\">\n                                Solicitação de Reset de Senha\n                            </h2>\n                        </td>\n                    </tr>\n\n                    <!-- Conteúdo -->\n                    <tr>\n                        <td style=\"padding:10px 40px 40px 40px;color:#374151;font-size:14px;line-height:1.7;\">\n\n                            <p>\n                                Olá,\n                                <strong>{{ $('Generate Check Code').item.json.name }}</strong>,\n                            </p>\n\n                            <p>\n                                Você solicitou um Reset de Senha. Segue abaixo o código de confirmação para utilizar na aplicação e gerar uma nova Senha:\n                            </p>\n\n                            <table width=\"100%\" cellpadding=\"10\" cellspacing=\"0\" border=\"0\"\n                                style=\"border-collapse:collapse;border:1px solid #d1d5db;margin-top:20px;margin-bottom:20px;\">\n\n                                <tr>\n                                    <td width=\"160\" style=\"background:#f9fafb;border-bottom:1px solid #d1d5db;\">\n                                        <strong>Código de Confirmação</strong>\n                                    </td>\n                                    <td style=\"border-bottom:1px solid #d1d5db;\">\n                                        {{ $('Generate Check Code').item.json.checkCode }}\n                                    </td>\n                                </tr>                                \n\n                            </table>\n\n                            <p>\n                                Se você não solicitou essa ação, ignore este e-mail.\n                            </p>\n\n                            <br>\n\n                            <p style=\"margin-bottom:0;\">\n                                At.te.,\n                            </p>\n\n                            <p style=\"margin-top:5px;\">\n                                <strong>Equipe BOLT de Segurança</strong>\n                            </p>\n\n                        </td>\n                    </tr>\n\n                    <!-- Rodapé -->\n                    <tr>\n                        <td align=\"center\"\n                            style=\"background:#f9fafb;padding:20px;font-size:12px;color:#6b7280;border-top:1px solid #e5e7eb;\">\n\n                            Esta é uma mensagem automática enviada pelo Sistema BOLT.<br>\n                            Não responda este e-mail.\n\n                        </td>\n                    </tr>\n\n                </table>\n\n            </td>\n        </tr>\n\n    </table>\n\n</body>\n\n</html>",
        "options": {}
      },
