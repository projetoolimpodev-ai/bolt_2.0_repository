        "jsCode": "const requesterScopes = $input.first().json.user.scopes;\nlet requestStatus = \"\";\n\nconst request = $('Webhook').first().json.query;\nconst messages = [];\n\nfunction isEmpty(value) {\n  return value == null || value === \"\";\n}\n\nfunction validateRequiredField(value, field, label) {\n  if (isEmpty(value)) {\n    messages.push(`O campo \"${label}\" (${field}) deve ser enviado na solicitação.`);\n  }\n}\n\nvalidateRequiredField(request._id, \"_id\", \"_ID\");\nvalidateRequiredField(request.executor, \"executor\", \"Executor\");\n\nif (messages.length) {\n  return {\n    code: 303,\n    description: \"Bad Request\",\n    messages\n  };\n}\n\nreturn {\n  code: 0\n};"
