    {
      "parameters": {
        "jsCode": "const requesterScopes = $('Verifica Validade do Solicitante').first().json.user.scopes;\nlet requestStatus = \"\";\n\nconst request = $('Webhook').first().json.body;\nconst scopes = $input.first().json.scopes;\n\nconst messages = [];\n\nfunction isEmpty(value) {\n  return value == null || value === \"\";\n}\n\nfunction validateRequiredField(value, field, label) {\n  if (isEmpty(value)) {\n    messages.push(`O campo \"${label}\" (${field}) deve ser enviado na solicitação.`);\n  }\n}\n\nfunction passwordValidation(password) {\n  return /^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[!@#$%&*])[A-Za-z\\d!@#$%&*]{8,}$/.test(password);\n}\n\nconst scopeMap = new Map();\n\nscopes.forEach(scope => { scopeMap.set(scope.mnemonic, new Set(scope.scopes.map(s => String(s.id)))); });\n\nvalidateRequiredField(request.name, \"name\", \"Nome\");\nvalidateRequiredField(request.email, \"email\", \"E-Mail\");\nvalidateRequiredField(request.phone, \"phone\", \"Telefone\");\n\nif (isEmpty(request.password)) {\n  messages.push('O campo \"Senha\" (password) deve ser enviado na solicitação.');\n} else if (!passwordValidation(request.password)) {\n  messages.push(\"O formato da senha está incorreto.\");\n}\n\nif (!Array.isArray(request.scopes) || request.scopes.length === 0) {\n  messages.push('O campo \"Acessos\" (scopes) deve conter pelo menos um valor válido.');\n} else {\n  request.scopes.forEach(scope => {\n\n    const [mnemonic, value] = scope.split(\".\");\n\n    const validScopes = scopeMap.get(mnemonic);\n\n    if (!validScopes) {\n      messages.push(`O Scope ${scope} não é válido.`);\n      return;\n    }\n\n    if (!validScopes.has(value)) {\n      messages.push(`O Scope ${scope} é inválido.`);\n    }\n\n  });\n}\n\nrequestStatus = 'active';\n\nif (messages.length) {\n  return {\n    code: 304,\n    description: \"Bad Request\",\n    messages\n  };\n}\n\nreturn {\n  code: 0,\n  requestStatus\n};"
      },
