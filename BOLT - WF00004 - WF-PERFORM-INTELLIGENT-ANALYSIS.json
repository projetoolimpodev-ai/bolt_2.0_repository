    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const data = $input.item.json.text;\nconst ocr = $input.item.json;\n\nlet reference = \"\";\nlet type = \"\";\n\nif (data) {\n\n  // ==================================================\n  // PREPARAR TEXTO\n  // ==================================================\n\n  const lines = data.split(/\\r?\\n/).map(linha => linha.trim()).filter(linha => linha !== \"\");\n  type = \"text\";\n\n  // ==================================================\n  // VERIFICAR SE É DA CAIXA ECONOMICA FEDERAL\n  // ==================================================\n  if (data.includes(\"SAC CAIXA\") || data.includes(\"Alô CAIXA\")) {\n    reference = 'cef';\n  }\n\n  // ==================================================\n  // VERIFICAR SE É DO NUBANK\n  // ==================================================\n  if (data.includes(\"nubank.com.br/contatos#ouvidoria\")) {\n    reference = 'nubank';\n  }\n\n  // ==================================================\n  // VERIFICAR SE É DO MERCADO PAGO\n  // ==================================================\n  if (data.includes(\"Mercado Pago Instituição de Pagamento Ltda.\")) {\n    reference = 'mercadoPago';\n  }\n\n  // ==================================================\n  // VERIFICAR SE É DO ITAÚ\n  // ==================================================\n  if (data.includes(\"extrato mensal\") || data.includes(\"Agência: Conta: Nome:\") || data.includes(\"Logotipo Itaú\")) {\n    reference = 'itau';\n  }\n\n  // ==================================================\n  // VERIFICAR SE É DO BRADESCO\n  // ==================================================\n  if (data.includes(\"Bradesco Celular\") || data.includes(\"Bradesco Internet Banking\")) {\n    reference = 'bradesco';\n  }\n\n  // ==================================================\n  // VERIFICAR SE É DO BANCO DO BRASIL\n  // ==================================================\n  if (data.includes(\"Extrato de Conta Corrente\")) {\n    reference = 'bancoDoBrasil';\n  }\n\n  return {reference, type: type, lines};\n  \n} else {\n\n  type = \"ocr\";\n\n  // ==================================================\n  // VERIFICAR SE É DA CAIXA ECONOMICA FEDERAL\n  // ==================================================\n  if (ocr.pages[0].markdown.includes(\"CAIXA\")) {\n    reference = 'cef';\n  }\n  \n  return { reference, type, pages: ocr.pages };\n  \n}"
      },
