atus }}\n                                    </td>\n                                </tr>\n\n                                <tr>\n                                    <td style=\"background:#f9fafb;\">\n                                        <strong>Scopes</strong>\n                                    </td>\n                                    <td>\n                                        <ul style=\"margin:0;padding-left:20px;\">\n                                            {{\n                                            $json.scopes\n                                            .map(scope => `<li><strong>${scope}</strong></li>\n                                            `)\n                                            .join('')\n                                            }}\n                                        </ul>\n                                    </td>\n                                </tr>\n\n                            </table>\n\n                            <p>\n                                Qualquer dúvida entre em contato com o administrador do Sistema.\n                            </p>\n\n                            <br>\n\n                            <p style=\"margin-bottom:0;\">\n                                At.te,\n                            </p>\n\n                            <p style=\"margin-top:5px;\">\n                                <strong>Equipe BOLT de Segurança</strong>\n                            </p>\n\n                        </td>\n                    </tr>\n\n                    <!-- Rodapé -->\n                    <tr>\n                        <td align=\"center\"\n                            style=\"background:#f9fafb;padding:20px;font-size:12px;color:#6b7280;border-top:1px solid #e5e7eb;\">\n\n                            Esta é uma mensagem automática enviada pelo Sistema BOLT.<br>\n                            Não responda este e-mail.\n\n                        </td>\n                    </tr>\n\n                </tab