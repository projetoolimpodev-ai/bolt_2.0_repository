    },
    {
      "parameters": {
        "jsCode": "const requesterScopes = $input.first().json.user.scopes;\nlet requestStatus = \"\";\n\nconst request = $('Webhook').first().json.body;\n\nconst messages = [];\n\nfunction isEmpty(value) {\n  return value == null || value === \"\";\n}\n\nfunction validateRequiredField(value, field, label) {\n  if (isEmpty(value)) {\n    messages.push(`O campo \"${label}\" (${field}) deve ser enviado na solicitação.`);\n  }\n}\n\nvalidateRequiredField(request.name, \"name\", \"Nome\");\nvalidateRequiredField(request.mnemonic, \"mnemonic\", \"Mneumônico\");\nvalidateRequiredField(request.description, \"description\", \"Descrição\");\n\nif (!Array.isArray(request.scopes) || request.scopes.length === 0) {\n  messages.push('O campo \"Scopes\" (scopes) deve conter pelo menos um valor válido.');\n}\n\nrequestStatus = 'active';\n\nif (messages.length) {\n  return {\n    code: 302,\n    description: \"Bad Request\",\n    messages\n  };\n}\n\nreturn {\n  code: 0,\n  requestStatus\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
