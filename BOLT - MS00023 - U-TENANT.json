    {
      "parameters": {
        "jsCode": "const incoming = $('Webhook').first().json.body;\nconst database = $input.all(1)[0].json;\n\n// Campos que nunca devem ser alterados\nconst ignoredFields = [\n    \"_id\",\n    \"action\",\n    \"createdAt\",\n    \"status\"\n];\n\nfunction mergeObjects(target, source) {\n\n    for (const key of Object.keys(source)) {\n\n        if (ignoredFields.includes(key)) {\n            continue;\n        }\n\n        const sourceValue = source[key];\n        const targetValue = target[key];\n\n        // Objeto\n        if (\n            sourceValue &&\n            typeof sourceValue === \"object\" &&\n            !Array.isArray(sourceValue)\n        ) {\n\n            if (\n                !targetValue ||\n                typeof targetValue !== \"object\" ||\n                Array.isArray(targetValue)\n            ) {\n                target[key] = {};\n            }\n\n            mergeObjects(target[key], sourceValue);\n            continue;\n        }\n\n        // Array (substitui completamente)\n        if (Array.isArray(sourceValue)) {\n            target[key] = sourceValue;\n            continue;\n        }\n\n        // Valor simples\n        target[key] = sourceValue;\n    }\n}\n\nmergeObjects(database, incoming);\n\ndatabase.updatedAt = new Date;\n\nreturn [\n    {\n        json: database\n    }\n];"
      },
      "type": "n8n-nodes-base.code",
