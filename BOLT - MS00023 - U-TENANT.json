        "jsCode": "const data = $input.item.json;\nlet body = {};\nlet _id = \"\";\nlet update = [];\n\nbody = data.body;\n_id = body._id;\n\nif (body.status) {\n  update.push(\"status\");\n}\n\nif (body.action === 'set_package') {\n  update.push(\"package\");\n}\n\nbody.updatedAt = new Date;\nupdate.push(\"updatedAt\");\n\nbody.update = update.join(\",\");\n\nreturn body;"
